{
  "name": "ollama-spacemolt-workspace",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:format && bun run check:lint && bun run check:test",
    "check:format": "biome format --write .",
    "check:lint": "biome lint --write .",
    "check:test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13"
  }
}
