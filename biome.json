{
	"$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
	"files": {
		"includes": [
			"**/*",
			"!client",
			"!node_modules",
			"!dist",
			"!bun.lock",
			"!memory.sqlite",
			"!.spacemolt-bot-credentials.json"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	}
}
